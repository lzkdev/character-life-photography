{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Character profile v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "ready"
      ]
    },
    "identity": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "fictional",
            "real"
          ]
        },
        "age_policy": {
          "enum": [
            "fixed",
            "birth_date",
            "unspecified"
          ]
        },
        "age": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "birth_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "age_policy",
        "age",
        "birth_date",
        "description"
      ],
      "additionalProperties": false
    },
    "canon": {
      "type": "object",
      "properties": {
        "identity_prompt": {
          "type": "string",
          "minLength": 1
        },
        "face": {
          "type": "string",
          "minLength": 1
        },
        "skin": {
          "type": "string",
          "minLength": 1
        },
        "hair": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "distinctive_features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "signature_items": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "structure": {
          "type": "object",
          "description": "New initialization records visual structure; legacy profiles may omit this block. Null means not established.",
          "properties": {
            "face_shape": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "eyes": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "brows": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "nose": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "lips": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "body_frame": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "face_shape",
            "eyes",
            "brows",
            "nose",
            "lips",
            "body_frame"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "identity_prompt",
        "face",
        "skin",
        "hair",
        "body",
        "distinctive_features",
        "signature_items"
      ],
      "additionalProperties": false
    },
    "variable_appearance": {
      "type": "object",
      "properties": {
        "hair": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "makeup": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "wardrobe": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "accessories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "hair",
        "makeup",
        "wardrobe",
        "accessories"
      ],
      "additionalProperties": false
    },
    "life": {
      "type": "object",
      "properties": {
        "personality": {
          "type": "string",
          "minLength": 1
        },
        "background": {
          "type": "string",
          "minLength": 1
        },
        "home_base": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "known_routines": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "personality",
        "background",
        "home_base",
        "known_routines",
        "unknowns"
      ],
      "additionalProperties": false
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "primary_identity",
              "identity_view",
              "body",
              "scene",
              "style",
              "continuity"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "active": {
            "type": "boolean"
          },
          "canon_version": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "role",
          "path",
          "sha256",
          "active",
          "canon_version",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "style_preferences": {
      "type": "object",
      "properties": {
        "default_preset": {
          "enum": [
            "natural_daily",
            "phone_snapshot",
            "documentary",
            "cinematic_daily",
            "film_daily",
            "soft_portrait",
            "custom"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "composition_constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "default_preset",
        "notes",
        "composition_constraints"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "snapshot_date": {
          "type": "string",
          "format": "date"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "file",
                  "url",
                  "user_message",
                  "example"
                ]
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "locator",
              "note"
            ],
            "additionalProperties": false
          }
        },
        "unresolved_conflicts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "proposed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "snapshot_date",
        "sources",
        "unresolved_conflicts",
        "proposed"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "display_name",
    "status",
    "identity",
    "canon",
    "variable_appearance",
    "life",
    "references",
    "style_preferences",
    "provenance"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        }
      },
      "then": {
        "properties": {
          "references": {
            "contains": {
              "properties": {
                "role": {
                  "const": "primary_identity"
                },
                "active": {
                  "const": true
                }
              },
              "required": [
                "role",
                "active"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "identity": {
            "properties": {
              "age_policy": {
                "const": "fixed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "identity": {
            "properties": {
              "age": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "identity": {
            "properties": {
              "age_policy": {
                "const": "birth_date"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "identity": {
            "properties": {
              "birth_date": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      }
    }
  ]
}
