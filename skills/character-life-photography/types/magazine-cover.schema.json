{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Magazine cover spec v1.0",
  "type": "object",
  "properties": {
    "deliverable": {
      "enum": [
        "cover-image",
        "finished-cover"
      ]
    },
    "setting": {
      "enum": [
        "studio",
        "location"
      ]
    },
    "aspect_ratio": {
      "type": "string",
      "minLength": 1
    },
    "copy": {
      "type": "object",
      "properties": {
        "masthead": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "cover_lines": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "issue": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "masthead",
        "cover_lines",
        "issue"
      ],
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "properties": {
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "face_clear_area": {
          "type": "string",
          "minLength": 1
        },
        "text_placement": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "intent",
        "face_clear_area",
        "text_placement"
      ],
      "additionalProperties": false
    },
    "print_requirements": {
      "type": "object",
      "minProperties": 1
    }
  },
  "required": [
    "deliverable",
    "setting",
    "aspect_ratio",
    "copy",
    "layout"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "deliverable": {
            "const": "finished-cover"
          }
        }
      },
      "then": {
        "properties": {
          "copy": {
            "properties": {
              "masthead": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "deliverable": {
            "const": "cover-image"
          }
        }
      },
      "then": {
        "properties": {
          "copy": {
            "properties": {
              "masthead": {
                "type": "null"
              },
              "cover_lines": {
                "maxItems": 0
              },
              "issue": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  ]
}
