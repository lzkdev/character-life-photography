        "mode",
        "camera_role",
        "trigger",
        "response",
        "gaze_target",
        "visible_cues"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "responsive"
              }
            }
          },
          "then": {
            "properties": {
              "trigger": {
                "type": "string",
                "minLength": 1
              },
              "response": {
                "type": "string",
                "minLength": 1
              },
              "visible_cues": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "creation": {
      "type": "object",
      "properties": {
        "type_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "type_version": {
          "type": "string",
          "minLength": 1
        },
        "spec": {
          "type": "object"
        }
      },
      "required": [
        "type_id",
        "type_version",
        "spec"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "record_stage",
    "shoot_id",
    "shot_id",
    "is_example",
    "character",
    "context",
    "event",
    "appearance",
    "photography",
    "continuity",
    "prompts",
    "generation",
    "qc",
    "evidence"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "record_stage": {
            "const": "plan"
          }
        }
      },
      "then": {
        "properties": {
          "generation": {
            "properties": {
              "status": {
                "const": "not_requested"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "generation": {
            "properties": {
              "status": {
                "not": {
                  "const": "not_requested"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "qc": {
            "properties": {
              "status": {
                "enum": [
                  "passed",
                  "needs_revision"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "generation": {
            "properties": {
              "status": {
                "const": "succeeded"
              }
            }
          },
          "qc": {
            "properties": {
              "reviewed_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "qc": {
            "properties": {
              "reviewed_at": {
                "type": "null"
              },
              "findings": {
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  ]
}
